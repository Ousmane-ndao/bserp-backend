APP_NAME=BSERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL (seul moteur supporté : voir config/database.php)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bserp
DB_USERNAME=postgres
DB_PASSWORD=
# 'require' en prod (Render/managed Postgres), 'disable' en local sans TLS
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# local = disque du conteneur/serveur ; r2 ou s3 = stockage objet (voir app/Support/DocumentsDisk.php)
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local

MAIL_MAILER=log

# Domaines autorisés à appeler l'API (CORS). Séparés par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Inscription ouverte via POST /api/register (désactivée par défaut)
APP_ALLOW_OPEN_REGISTRATION=false

SWAGGER_GENERATE_ALWAYS=true
